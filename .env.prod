# Production configuration (Key parity with .env.dev)
ENVIRONMENT=production
DEBUG=false
POSTGRES_USER=app_prod_user
POSTGRES_PASSWORD=replace_in_vault
POSTGRES_DB=scaffold_prod
POSTGRES_HOST=prod-db-host
DATABASE_URL=postgresql://app_prod_user:replace_in_vault@prod-db-host:5432/scaffold_prod
VALKEY_HOST=prod-valkey-host
VALKEY_URL=valkey://prod-valkey-host:6379
DATA_DIR=/var/data
DOCKER_DATA_DIR=/var/data/docker
STORE_PASSWORD=replace_in_vault
OLLAMA_HOST=http://ollama-service:11434
OLLAMA_DEFAULT_MODEL=gpt-oss:20b-cloud
OLLAMA_REQUEST_TIMEOUT=120.0
