# Local Development configuration
ENVIRONMENT=development
DEBUG=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scaffold_dev
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scaffold_dev
VALKEY_HOST=localhost
VALKEY_URL=valkey://localhost:6379
DATA_DIR=.cache/.data
DOCKER_DATA_DIR=${HOME}/.data
STORE_PASSWORD=dev_insecure_passphrase_change_in_vault
# OLLAMA_HOST will automatically resolve host WSL gateway IP if unset
OLLAMA_DEFAULT_MODEL=gpt-oss:20b-cloud
OLLAMA_REQUEST_TIMEOUT=120.0
